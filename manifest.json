{
  "manifest_version": 3,
  "name": "Auto Refresh",
  "version": "1.0",
  "description": "Auto-refresh the current tab on a user-defined interval (in seconds).",
  "permissions": ["alarms", "storage", "tabs"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
